# Brandy Configuration Example
# Copy this file to .env and adjust values as needed

# Cache settings
ENABLE_CACHE=true
CACHE_EXPIRY_DAYS=7

# Selenium settings
HEADLESS_BROWSER=true
SELENIUM_TIMEOUT=10

# API settings (if using REST API)
API_HOST=0.0.0.0
API_PORT=8000

# INDECOPI URLs (in case they change)
INDECOPI_SEARCH_URL=https://pi.indecopi.gob.pe/buscatumarca/

# Database settings
# For MySQL (default):
DB_HOST=localhost
DB_PORT=3306
DB_NAME=brandy
DB_USER=root
DB_PASSWORD=
DB_MAX_CONNECTIONS=10

# For PostgreSQL (alternative):
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_MIN_CONNECTIONS=1
